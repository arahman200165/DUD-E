{
  "name": "dude",
  "version": "0.0.6",
  "description": "DUDE — Developer Utility Dashboard Engine: a dark-mode-only, offline-capable PWA of client-side developer micro-tools, also shipping as a Windows Electron desktop build.",
  "author": "arahman200165",
  "main": "dist/electron/main.js",
  "engines": {
    "npm": "11.19.0",
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "ng build && playwright test --config=e2e/playwright.config.ts",
    "playwright:install": "playwright install chromium",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "electron:compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist/electron --external:electron",
    "electron:start": "ng build --configuration production,electron && npm run electron:compile && electron dist/electron/main.js",
    "electron:dev": "concurrently -k -s first \"ng serve\" \"wait-on http://localhost:4200 && npm run electron:compile && cross-env DUDE_ELECTRON_DEV_SERVER_URL=http://localhost:4200 electron dist/electron/main.js\"",
    "electron:package": "ng build --configuration production,electron && npm run electron:compile && electron-builder --config electron-builder.yml --win nsis appx",
    "relay:compile": "esbuild relay/index.ts --bundle --platform=node --format=cjs --outdir=dist/relay",
    "relay:dev": "npm run relay:compile && node dist/relay/index.js"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@faker-js/faker": "^10.6.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "colord": "^2.10.0",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.24.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.15",
    "ejs": "^6.0.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "franc-min": "^6.2.0",
    "humanize-duration": "^3.35.0",
    "isomorphic-git": "^1.42.2",
    "jmespath": "^0.16.0",
    "jose": "^6.2.12",
    "js-md5": "^0.9.2",
    "js-yaml": "^5.4.2",
    "jsonpath-plus": "^10.4.0",
    "jsonrepair": "^3.15.0",
    "lib0": "^0.2.117",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "papaparse": "^5.7.0",
    "parse-duration": "^2.1.9",
    "picomatch": "^4.0.7",
    "pyodide": "^314.0.7",
    "regexp-tree": "^0.1.27",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.0",
    "semver": "^7.8.5",
    "tiptap-markdown": "^0.9.0",
    "tslib": "^2.3.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/diff-match-patch": "^1.0.36",
    "@types/ejs": "^3.1.5",
    "@types/humanize-duration": "^3.27.4",
    "@types/jmespath": "^0.15.2",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.24.2": true,
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
